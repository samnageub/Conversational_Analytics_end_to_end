table response
	lineageTag: 21291ed0-157e-4f09-94b7-20de59bd6fb3
	sourceLineageTag: [dbo].[fact_response]

	/// Counts the total number of rows in the 'response' table to return the total number of responses.
	measure 'Total Responses' =
			
			COUNTROWS ( 'response' )
		formatString: #,0
		lineageTag: 6db53966-735b-4583-b5ed-8e9d4cb09e66

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Counts the number of responses marked as correct in the 'response' table.
	measure 'Correct Responses' =
			
			CALCULATE (
			    COUNTROWS ( 'response' ),
			    'response'[is_correct] = TRUE ()
			)
		formatString: #,0
		lineageTag: 1af6a278-e999-4fe9-b43a-7f7f23930e5d

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Calculate the number of incorrect responses by subtracting Correct Responses from Total Responses.
	measure 'Incorrect Responses' =
			
			[Total Responses] - [Correct Responses]
		formatString: #,0
		lineageTag: cd70d74e-5222-4f5c-a98f-9be4a9f93344

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Calculates the percentage of topic accuracy by dividing the number of correct responses by the total responses.
	measure 'Topic Accuracy' =
			
			DIVIDE (
			    [Correct Responses],
			    [Total Responses]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0d51957a-c5a8-40c1-a64a-f09710dbd012

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

	/// Calculates the average response time in seconds across all response records.
	measure 'Average Response Time' =
			
			AVERAGE (
			    'response'[response_seconds]
			)
		formatString: 0.0
		lineageTag: 1a3ff940-69b3-41f5-bf0b-bcf2e4034d57

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Calculates the average number of points earned across all response records.
	measure 'Average Points Earned' =
			
			AVERAGE (
			    'response'[points_earned]
			)
		formatString: 0.0
		lineageTag: c3b59c62-85ab-4aef-b944-ea7b6b6eb43e

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

