table attempt
	lineageTag: 67f37035-01db-4a40-8a20-1eb176d74a66
	sourceLineageTag: [dbo].[fact_attempt]

	/// Counts the number of completed test attempts by counting rows in the attempt table.
	measure 'Completed Tests' =
			
			COUNTROWS ( attempt)
		formatString: #,0
		lineageTag: 4c488c53-5bea-47ec-9f39-0ce6d607bb82

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Counts the number of attempt records where the passed flag is TRUE, representing the total count of passed tests.
	measure 'Passed Tests' =
			
			CALCULATE (
			    COUNTROWS( 'attempt'),
			    'attempt'[passed] = TRUE ()
			)
		formatString: #,0
		lineageTag: 91ca7bcd-5379-4e3e-b3c9-a5d21a439801

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Calculates the number of failed tests by subtracting Passed Tests from Completed Tests.
	measure 'Failed Tests' =
			
			[Completed Tests] - [Passed Tests]
		formatString: #,0
		lineageTag: 38eb3037-d025-421f-8e84-ded6e283ae02

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		changedProperty = IsHidden

	measure 'Pass Rate' =
			
			DIVIDE (
			    [Passed Tests],
			    [Completed Tests]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2d1e04d2-416d-49b0-b2d5-d62b67c3c67d

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Calculates the average of the 'score' values across all records in the 'attempt' table.
	measure 'Average Score' =
			
			AVERAGE ( 'attempt'[score] )
		formatString: 0.0
		lineageTag: b24cb176-b144-465d-abc7-b8a5713ed143

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Calculates the average test duration in minutes across all attempts in the 'attempt' table.
	measure 'Average Test Duration' =
			
			AVERAGE ( 'attempt'[duration_minutes] )
		formatString: 0.0
		lineageTag: 4addc4d0-d17e-40b3-adaf-e40f35a622a2

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Counts the number of unique test takers based on the distinct candidate_key values in the attempt table.
	measure 'Unique Test Takers' =
			
			DISTINCTCOUNT (
			    'attempt'[candidate_key]
			)
		formatString: #,0
		lineageTag: d6f0efca-11d2-439d-aad4-60b5649c25f5

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Calculates the completion rate as the ratio of completed tests to total registrations.
	measure 'Completion Rate' =
			
			DIVIDE (
			    [Completed Tests],
			    [Registrations]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b227e162-abf5-471c-a8ee-c2e8bed18ba3

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

		changedProperty = IsHidden

	/// Calculates the year to date total of completed tests based on the 'Date'[calendar_date] column.
	measure 'Completed Tests YTD' =
			
			CALCULATE (
			    [Completed Tests],
			    DATESYTD ( 'Date'[calendar_date] )
			)
		formatString: #,0.00
		lineageTag: 135a0f03-76a9-4975-a479-991c5c146332

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Calculates the completed tests for the same year-to-date period in the previous calendar year, based on the Completed Tests Year to Date measure and the calendar date from the Date table.
	measure 'Completed Tests Previous Year YTD' =
			
			CALCULATE (
			    [Completed Tests YTD],
			    SAMEPERIODLASTYEAR ( 'Date'[calendar_date] )
			)
		formatString: #,0
		lineageTag: 8cad460d-c24f-4943-93ed-90bac74c0e19

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Calculates the year over year percentage change in completed tests by comparing completed tests year to date with completed tests for the same year to date period in the previous year.
	measure 'Completed Tests YoY %' =
			
			DIVIDE (
			    [Completed Tests YTD] - [Completed Tests Previous Year YTD],
			    [Completed Tests Previous Year YTD]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c69edb77-231c-4dca-8c59-9490e8952dbb

		changedProperty = Name

		changedProperty = Description

		changedProperty = IsHidden

		changedProperty = FormatString

	/// Calculates the year-to-date pass rate by evaluating [Pass Rate] over all dates from the start of the calendar year up to the current filter context date.
	measure 'Pass Rate YTD' =
			
			CALCULATE (
			    [Pass Rate],
			    DATESYTD ( 'Date'[calendar_date] )
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4214ef56-f57e-4ba4-accc-df644732c1b1

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	measure 'Pass Rate Previous Year YTD' =
			
			CALCULATE (
			    [Pass Rate YTD],
			    SAMEPERIODLASTYEAR ( 'Date'[calendar_date] )
			)
		lineageTag: 8c7a54b0-bfe3-41d2-91cc-e2ae6ebd483a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Calculates the year over year change in the pass rate by subtracting Pass Rate Previous Year Year to date from Pass Rate Year to date.
	measure 'Pass Rate YoY Change' =
			
			[Pass Rate YTD] - [Pass Rate Previous Year YTD]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 866a5b2c-e739-4e94-a973-45f78438e408

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

