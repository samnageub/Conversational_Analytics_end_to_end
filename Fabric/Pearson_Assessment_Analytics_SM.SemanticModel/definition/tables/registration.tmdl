table registration
	lineageTag: 47950260-c0b2-40f7-8d83-66a99f494a2a
	sourceLineageTag: [dbo].[fact_registration]

	/// Total Number of Registrations
	measure Registrations =
			
			COUNTROWS (registration)
		formatString: #,0
		lineageTag: 417b919e-1a9d-4baa-848d-8a94a5a8b976

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Counts the number of distinct registered candidates based on the candidate_key in the registration table.
	measure 'Unique Registered Candidates' =
			
			DISTINCTCOUNT(registration[candidate_key])
		formatString: #,0
		lineageTag: c74d347a-ba1b-484f-be9b-643d07f78ed9

		changedProperty = Name

		changedProperty = FormatString

		changedProperty = Description

	/// Calculates the average number of registrations per unique registered candidate by dividing total registrations by the count of unique registered candidates.
	measure 'Registrations per Candidate' =
			
			DIVIDE (
			    [Registrations],
			    [Unique Registered Candidates]
			)
		formatString: #,0.0
		lineageTag: ea0c4ec8-a173-4d3d-83d6-a0cc4fdf297e

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Calculates the year-to-date total of registrations based on the 'Date'[calendar_date] context.
	measure 'Registrations YTD' =
			
			CALCULATE (
			    [Registrations],
			    DATESYTD ( 'Date'[calendar_date] )
			)
		formatString: #,0.00
		lineageTag: 5949f808-c59a-4ee8-b3e1-7d0f2e245f7c

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Returns the year-to-date registrations for the same period in the previous calendar year, using the Date[calendar_date] column to shift the [Registrations YTD] measure one year back.
	measure 'Registrations Previous Year YTD' =
			
			CALCULATE (
			    [Registrations YTD],
			    SAMEPERIODLASTYEAR ( 'Date'[calendar_date] )
			)
		formatString: #,0
		lineageTag: 67d3a307-7326-48b9-a844-64efe354b3f1

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Calculates the year-over-year percentage change in year-to-date registrations compared to the previous year's year-to-date registrations.
	measure 'Registrations YoY %' =
			
			DIVIDE (
			    [Registrations YTD] - [Registrations Previous Year YTD],
			    [Registrations Previous Year YTD]
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: a6dd2c9a-1f28-40d9-ae7f-3d7042e4820e

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

