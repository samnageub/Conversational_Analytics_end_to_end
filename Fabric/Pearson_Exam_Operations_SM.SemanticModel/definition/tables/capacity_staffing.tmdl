table capacity_staffing
	lineageTag: a85bf27b-46bc-4396-8a68-c76915de9215
	sourceLineageTag: [dbo].[fact_capacity_staffing]

	/// Calculates the total planned physical capacity by summing the physical_capacity values across all relevant records.
	measure 'Planned Capacity' =
			
			SUM ( 'capacity_staffing'[physical_capacity] )
		formatString: #,0
		lineageTag: 0283d6a4-3548-4abc-9274-5dc9c59d203e

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Sums the planned_demand values in the capacity_staffing table to calculate total planned demand for the selected filter context.
	measure 'Planned Demand' =
			
			SUM ( 'capacity_staffing'[planned_demand] )
		formatString: #,0
		lineageTag: 34cbb881-a218-4501-bd5c-afa57a9bc7a8

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Sums the capacity_gap values to show the total staffing capacity shortfall across the selected context.
	measure 'Capacity Gap' =
			
			SUM ( capacity_staffing[capacity_gap] )
		formatString: 0
		lineageTag: 5f5272f4-db4e-4cee-affc-fd4c4c0beabb

		changedProperty = Name

		changedProperty = Description

		changedProperty = IsHidden

	/// Calculates planned utilization as the ratio of Planned Demand to Planned Capacity to show how fully planned capacity is expected to be used.
	measure 'Planned Utilization' =
			
			DIVIDE (
			    [Planned Demand],
			    [Planned Capacity]
			)
		formatString: #,0.0%;-#,0.0%;#,0.0%
		lineageTag: dae6cd11-3fe9-4bc2-9839-13182d0ecfb7

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

		changedProperty = IsHidden

	/// Calculates the total number of proctors required by summing the 'proctors_required' column in the Capacity_Staffing table.
	measure 'Proctors Required' =
			
			SUM ( 'Capacity_Staffing'[proctors_required] )
		formatString: #,0
		lineageTag: 2359d63d-beb1-4d29-ab16-c5ed1451e3f5

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Sums the number of proctors available across the selected filter context.
	measure 'Proctors Available' =
			
			SUM ( 'capacity_staffing'[proctors_available] )
		formatString: #,0
		lineageTag: 12554c5b-9ca5-4c19-9e75-fafa515622ff

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Calculates the total staffing gap by summing the 'Capacity_Staffing'[staffing_gap] values over the current filter context.
	measure 'Staffing Gap' =
			
			SUM ( 'Capacity_Staffing'[staffing_gap] )
		formatString: #,0
		lineageTag: 894da910-be5a-4c91-ad91-9ec71f04e7e5

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

	/// Calculates the staffing coverage ratio by dividing the number of proctors available by the number of proctors required, indicating how fully proctor needs are met.
	measure 'Staffing Coverage' =
			
			DIVIDE (
			    [Proctors Available],
			    [Proctors Required]
			)
		formatString: #,0.00
		lineageTag: 9e3fd24c-81bf-4594-a1cc-6d5e3344c75a

		changedProperty = Name

		changedProperty = Description

		changedProperty = FormatString

